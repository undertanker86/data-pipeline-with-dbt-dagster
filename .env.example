# Copy to .env and fill in. Values below for DATA_DB_* match the throwaway
# Docker Postgres this project was developed against - override if pointing
# at a different database.
DATA_DB_HOST=localhost
DATA_DB_PORT=5432
DATA_DB_NAME=data_pipeline
DATA_DB_USER=postgres
DATA_DB_PASSWORD=postgres

# Gmail requires an App Password (16 chars, needs 2FA enabled first) - not
# your normal account password. Leave blank to disable the failure-email
# sensor (it then just logs a warning on failure instead of crashing).
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
ALERT_EMAIL_TO=
